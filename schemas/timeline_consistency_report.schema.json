{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://detariki-kb/schemas/timeline_consistency_report.schema.json",
  "title": "Timeline Consistency Report",
  "description": "複数のStage A episode_extractionに含まれるrelative_order候補のsame_time縮約・横断循環とepisode metadata順序値の競合検出結果",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["0.2", "0.3"] } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": [
          "checkedSameTimeCandidateCount",
          "distinctSameTimeEdgeCount",
          "sameTimeClassCount",
          "distinctClassEdgeCount"
        ],
        "properties": {
          "findings": {
            "items": { "$ref": "#/definitions/FindingV02" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": "0.3" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": [
          "explicitOrderCandidateCount",
          "numericEpisodeObservationCount",
          "numericEpisodeOrderGroupCount",
          "numericIgnoredObservationCount",
          "numericIgnoredObservations",
          "numericFindingCount",
          "numericFindings"
        ]
      }
    }
  ],
  "required": [
    "schemaVersion",
    "documentType",
    "status",
    "inputFiles",
    "resolvedInputFiles",
    "validInputs",
    "invalidInputs",
    "skippedInputs",
    "inputResults",
    "timelineCandidateCount",
    "relativeOrderCandidateCount",
    "checkedCandidateCount",
    "distinctEdgeCount",
    "ignoredCandidateCount",
    "ignoredCandidates",
    "findingCount",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "enum": ["0.1", "0.2", "0.3"] },
    "documentType": { "const": "timeline_consistency_report" },
    "status": {
      "enum": ["passed", "needs_review", "invalid_input"]
    },
    "inputFiles": { "type": "integer", "minimum": 0 },
    "resolvedInputFiles": { "type": "integer", "minimum": 0 },
    "validInputs": { "type": "integer", "minimum": 0 },
    "invalidInputs": { "type": "integer", "minimum": 0 },
    "skippedInputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputResults": {
      "type": "array",
      "items": { "$ref": "#/definitions/InputResult" }
    },
    "timelineCandidateCount": { "type": "integer", "minimum": 0 },
    "relativeOrderCandidateCount": { "type": "integer", "minimum": 0 },
    "checkedCandidateCount": { "type": "integer", "minimum": 0 },
    "distinctEdgeCount": { "type": "integer", "minimum": 0 },
    "checkedSameTimeCandidateCount": { "type": "integer", "minimum": 0 },
    "distinctSameTimeEdgeCount": { "type": "integer", "minimum": 0 },
    "sameTimeClassCount": { "type": "integer", "minimum": 0 },
    "distinctClassEdgeCount": { "type": "integer", "minimum": 0 },
    "ignoredCandidateCount": { "type": "integer", "minimum": 0 },
    "ignoredCandidates": {
      "type": "array",
      "items": { "$ref": "#/definitions/IgnoredCandidate" }
    },
    "findingCount": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/Finding" }
    },
    "explicitOrderCandidateCount": { "type": "integer", "minimum": 0 },
    "numericEpisodeObservationCount": { "type": "integer", "minimum": 0 },
    "numericEpisodeOrderGroupCount": { "type": "integer", "minimum": 0 },
    "numericIgnoredObservationCount": { "type": "integer", "minimum": 0 },
    "numericIgnoredObservations": {
      "type": "array",
      "items": { "$ref": "#/definitions/NumericIgnoredObservation" }
    },
    "numericFindingCount": { "type": "integer", "minimum": 0 },
    "numericFindings": {
      "type": "array",
      "items": { "$ref": "#/definitions/NumericFinding" }
    }
  },
  "definitions": {
    "InputResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "errors", "warnings"],
      "properties": {
        "path": { "type": "string" },
        "status": { "enum": ["valid", "invalid", "skipped"] },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CandidateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "episodeId", "candidateId", "evidenceIds"],
      "properties": {
        "sourcePath": { "type": "string" },
        "episodeId": { "type": "string" },
        "candidateId": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "IgnoredCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "sourcePath",
        "episodeId",
        "candidateId",
        "evidenceIds",
        "relativeTo",
        "relation"
      ],
      "properties": {
        "reason": {
          "enum": [
            "missing_relative_to",
            "missing_relation",
            "same_time_not_checked",
            "target_not_loaded",
            "unsupported_relation"
          ]
        },
        "sourcePath": { "type": "string" },
        "episodeId": { "type": "string" },
        "candidateId": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "relativeTo": { "type": ["string", "null"] },
        "relation": { "type": ["string", "null"] }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromEpisodeId",
        "toEpisodeId",
        "sourceEpisodeId",
        "relativeTo",
        "relation",
        "sourcePath",
        "candidateId",
        "evidenceIds"
      ],
      "properties": {
        "fromEpisodeId": { "type": "string" },
        "toEpisodeId": { "type": "string" },
        "sourceEpisodeId": { "type": "string" },
        "relativeTo": { "type": "string" },
        "relation": { "enum": ["before", "after"] },
        "sourcePath": { "type": "string" },
        "candidateId": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SameTimeEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceEpisodeId",
        "relativeTo",
        "relation",
        "sourcePath",
        "candidateId",
        "evidenceIds"
      ],
      "properties": {
        "sourceEpisodeId": { "type": "string" },
        "relativeTo": { "type": "string" },
        "relation": { "const": "same_time" },
        "sourcePath": { "type": "string" },
        "candidateId": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "severity", "episodeIds", "candidateRefs", "edges"],
      "properties": {
        "rule": {
          "enum": [
            "timeline_relative_order_cycle",
            "timeline_relative_order_within_same_time_class"
          ]
        },
        "severity": { "const": "warning" },
        "episodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "candidateRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/CandidateRef" }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Edge" }
        },
        "sameTimeEdges": {
          "type": "array",
          "items": { "$ref": "#/definitions/SameTimeEdge" }
        },
        "sameTimeClassEpisodeIds": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "FindingV02": {
      "allOf": [
        { "$ref": "#/definitions/Finding" },
        {
          "required": ["sameTimeEdges", "sameTimeClassEpisodeIds"],
          "if": {
            "properties": {
              "rule": {
                "const": "timeline_relative_order_within_same_time_class"
              }
            },
            "required": ["rule"]
          },
          "then": {
            "properties": {
              "sameTimeEdges": { "minItems": 1 },
              "sameTimeClassEpisodeIds": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "ExtractionRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractionVersion",
        "extractionMethod",
        "modelProvider",
        "modelName",
        "promptVersion",
        "extractedAt",
        "parserCompatibilityAtExtraction"
      ],
      "properties": {
        "extractionVersion": { "type": "string" },
        "extractionMethod": {
          "enum": ["rule_based", "llm", "manual", "hybrid"]
        },
        "modelProvider": { "type": ["string", "null"] },
        "modelName": { "type": ["string", "null"] },
        "promptVersion": { "type": ["string", "null"] },
        "extractedAt": { "type": ["string", "null"] },
        "parserCompatibilityAtExtraction": {
          "enum": ["compatible", "warning", "needs_update", "blocked"]
        }
      }
    },
    "NumericObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "episodeId",
        "candidateId",
        "evidenceIds",
        "scope",
        "orderField",
        "orderValue",
        "extractionRun"
      ],
      "properties": {
        "sourcePath": { "type": "string" },
        "episodeId": { "type": "string" },
        "candidateId": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": { "const": "episode" },
        "orderField": {
          "enum": ["canonicalOrder", "releaseOrder", "displayOrder"]
        },
        "orderValue": { "type": "number" },
        "extractionRun": { "$ref": "#/definitions/ExtractionRun" }
      }
    },
    "NumericIgnoredObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "sourcePath",
        "episodeId",
        "candidateId",
        "evidenceIds",
        "scope",
        "orderField",
        "orderValue",
        "extractionRun"
      ],
      "properties": {
        "reason": {
          "enum": [
            "unsupported_scope",
            "missing_order_field",
            "unsupported_order_field",
            "missing_order_value"
          ]
        },
        "sourcePath": { "type": "string" },
        "episodeId": { "type": "string" },
        "candidateId": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": { "type": ["string", "null"] },
        "orderField": { "type": ["string", "null"] },
        "orderValue": { "type": ["number", "null"] },
        "extractionRun": { "$ref": "#/definitions/ExtractionRun" }
      }
    },
    "NumericFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "episodeId",
        "orderField",
        "values",
        "observations"
      ],
      "properties": {
        "rule": { "const": "timeline_episode_order_field_value_conflict" },
        "severity": { "const": "warning" },
        "episodeId": { "type": "string" },
        "orderField": {
          "enum": ["canonicalOrder", "releaseOrder", "displayOrder"]
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "number" }
        },
        "observations": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/NumericObservation" }
        }
      }
    }
  }
}
