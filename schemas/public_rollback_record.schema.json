{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://detariki-kb.local/schemas/public_rollback_record.schema.json",
  "title": "DKB Known Public Rollback Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentType", "classification", "commitAllowed", "sourceSha", "treeSha256", "runId", "publicUrl"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "documentType": { "const": "public_rollback_record" },
    "classification": { "const": "public" },
    "commitAllowed": { "const": true },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "treeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runId": { "type": "integer", "minimum": 1 },
    "publicUrl": { "type": "string", "pattern": "^https://[^\\s]+/$" }
  }
}
