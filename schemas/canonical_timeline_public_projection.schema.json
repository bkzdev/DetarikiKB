{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://detariki-kb/schemas/canonical_timeline_public_projection.schema.json",
  "title": "Canonical Timeline Public Projection",
  "description": "採択済みP1-P7に基づくEVENT限定public-safe projection v0.1。adoption済みknown relationを確認済み関係ナビゲーションとして表示するためのallowlist契約であり、internal canonical artifact、provenance、自由記述reasonを含まない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "visibility",
    "publishStatus",
    "scope",
    "purpose",
    "coverageNoticeKey",
    "components",
    "unresolvedRelationSummary"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "documentType": { "const": "canonical_timeline_public_projection" },
    "visibility": { "const": "public" },
    "publishStatus": { "const": "projection_candidate" },
    "scope": { "const": "event" },
    "purpose": { "const": "confirmed_relation_navigation" },
    "coverageNoticeKey": { "const": "partial_confirmed_relations_only" },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/TimelineComponent" }
    },
    "unresolvedRelationSummary": {
      "oneOf": [
        { "$ref": "#/definitions/UnresolvedRelationSummary" },
        { "type": "null" }
      ]
    }
  },
  "definitions": {
    "PublicLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "PublicId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "PublicEpisodeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicStoryId",
        "publicEpisodeId",
        "storyLabel",
        "episodeLabel"
      ],
      "properties": {
        "publicStoryId": { "$ref": "#/definitions/PublicId" },
        "publicEpisodeId": { "$ref": "#/definitions/PublicId" },
        "storyLabel": { "$ref": "#/definitions/PublicLabel" },
        "episodeLabel": { "$ref": "#/definitions/PublicLabel" }
      }
    },
    "PublicTimelineRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromPublicEpisodeId",
        "toPublicEpisodeId",
        "relationState",
        "labelKey"
      ],
      "properties": {
        "fromPublicEpisodeId": { "$ref": "#/definitions/PublicId" },
        "toPublicEpisodeId": { "$ref": "#/definitions/PublicId" },
        "relationState": { "enum": ["before", "after", "same_time"] },
        "labelKey": {
          "enum": ["timeline_before", "timeline_after", "timeline_same_time"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "relationState": { "const": "before" } },
            "required": ["relationState"]
          },
          "then": { "properties": { "labelKey": { "const": "timeline_before" } } }
        },
        {
          "if": {
            "properties": { "relationState": { "const": "after" } },
            "required": ["relationState"]
          },
          "then": { "properties": { "labelKey": { "const": "timeline_after" } } }
        },
        {
          "if": {
            "properties": { "relationState": { "const": "same_time" } },
            "required": ["relationState"]
          },
          "then": {
            "properties": { "labelKey": { "const": "timeline_same_time" } }
          }
        }
      ]
    },
    "TimelineComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentKey", "nodes", "relations"],
      "properties": {
        "componentKey": {
          "type": "string",
          "pattern": "^component-[0-9]{4}$"
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/PublicEpisodeNode" }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/PublicTimelineRelation" }
        }
      }
    },
    "UnresolvedRelationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countScope",
        "noticeKey",
        "unknownCount",
        "conflictCount"
      ],
      "properties": {
        "countScope": { "const": "canonical_artifact_only" },
        "noticeKey": { "const": "unresolved_relations_not_shown" },
        "unknownCount": { "type": "integer", "minimum": 0 },
        "conflictCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
